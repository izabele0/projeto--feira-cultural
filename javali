
const campoTexto = document.getElementById("texto");
const campoVoz = document.getElementById("voz");
const velocidade = document.getElementById("velocidade");
const status = document.getElementById("status");

let vozes = [];

function carregarVozes() {

    vozes = speechSynthesis.getVoices();

    campoVoz.innerHTML = "";

    // Seleciona somente vozes em português
    const vozesPortugues = vozes.filter(voz =>
        voz.lang.toLowerCase() === "pt-br"
    );

    if (vozesPortugues.length === 0) {

        campoVoz.innerHTML =
            '<option value="">Voz pt-BR não encontrada no dispositivo</option>';

        status.textContent =
            "Instale uma voz em português do Brasil no seu dispositivo.";

        return;
    }

    vozesPortugues.forEach((voz) => {

        const opcao = document.createElement("option");

        opcao.value = vozes.indexOf(voz);

        opcao.textContent = voz.name + " (Português Brasil)";

        campoVoz.appendChild(opcao);

    });
}

speechSynthesis.onvoiceschanged = carregarVozes;

carregarVozes();


function falar() {

    const texto = campoTexto.value.trim();

    if (texto === "") {

        status.textContent = "Digite um texto primeiro.";

        campoTexto.focus();

        return;
    }

    const vozSelecionada = vozes.find(voz =>
        voz.lang.toLowerCase() === "pt-br" &&
        vozes.indexOf(voz) === Number(campoVoz.value)
    );

    if (!vozSelecionada) {

        status.textContent =
            "Nenhuma voz brasileira disponível.";

        return;
    }

    speechSynthesis.cancel();

    const leitura = new SpeechSynthesisUtterance(texto);

    leitura.voice = vozSelecionada;

    leitura.lang = "pt-BR";

    leitura.rate = Number(velocidade.value);

    leitura.onstart = () => {
        status.textContent = "Lendo em português brasileiro...";
    };

    leitura.onend = () => {
        status.textContent = "Leitura concluída!";
    };

    leitura.onerror = () => {
        status.textContent = "Erro ao reproduzir a voz.";
    };

    speechSynthesis.speak(leitura);
}


function pausar() {

    if (speechSynthesis.speaking && !speechSynthesis.paused) {

        speechSynthesis.pause();

        status.textContent = "Leitura pausada.";
    }
}


function continuar() {

    if (speechSynthesis.paused) {

        speechSynthesis.resume();

        status.textContent = "Continuando a leitura...";
    }
}


function parar() {

    speechSynthesis.cancel();

    status.textContent = "Leitura interrompida.";
}


function limpar() {

    speechSynthesis.cancel();

    campoTexto.value = "";

    status.textContent = "Texto apagado.";

    campoTexto.focus();
}

}
